rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Strict Administrator Authorization:
    // Requires either:
    // 1. Firebase Auth custom claim `admin == true` or `role == 'SUPER_ADMIN'`
    // 2. Verified admin record in /admins/{uid}
    // 3. Designated primary administrator email (fatiufaruk7@gmail.com)
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'SUPER_ADMIN' ||
        request.auth.token.role == 'admin' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && (
          request.auth.token.email == 'fatiufaruk7@gmail.com' ||
          request.auth.token.email.matches('(?i)^fatiufaruk7@gmail\\.com$')
        ))
      );
    }

    // Staff Authorization:
    // Allows access for any recognized staff role (SUPER_ADMIN, MANAGER, SUPPORT, DEVELOPER, EDITOR)
    function isStaff() {
      return isSignedIn() && (
        isAdmin() ||
        request.auth.token.role in ['SUPER_ADMIN', 'MANAGER', 'SUPPORT', 'DEVELOPER', 'EDITOR'] ||
        exists(/databases/$(database)/documents/staff/$(request.auth.uid))
      );
    }

    function isValidSubmission(data) {
      return data.keys().hasAll(['name', 'email', 'message']) &&
             data.name is string && data.name.size() >= 2 && data.name.size() <= 120 &&
             data.email is string && data.email.size() >= 5 && data.email.size() <= 150 &&
             data.message is string && data.message.size() >= 5 && data.message.size() <= 3000;
    }

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Administrators registry:
    // Strictly restricted to authorized administrators
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // Staff members collection (RBAC):
    match /staff/{staffId} {
      allow read: if isStaff() || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Site settings collection (e.g. siteSettings/main):
    // Public can read to render company details, hero, footer, and social links.
    // Strictly restricted to SUPER_ADMIN for modifications.
    match /siteSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Legacy settings collection:
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Primary contact submissions collection:
    // Public visitors can submit contact forms
    // Authorized staff and administrators can view, review, assign, and update status/notes
    match /contactSubmissions/{submissionId} {
      allow create: if isValidSubmission(incoming());
      allow read: if isStaff() || isAdmin();
      allow update: if isStaff() || isAdmin();
      allow delete: if isAdmin();
    }

    // Legacy submissions collection:
    match /submissions/{submissionId} {
      allow create: if isValidSubmission(incoming());
      allow read: if isStaff() || isAdmin();
      allow update: if isStaff() || isAdmin();
      allow delete: if isAdmin();
    }

    // Projects collection:
    match /projects/{projectId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Services collection:
    match /services/{serviceId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Testimonials collection:
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
